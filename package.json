{
  "name": "blacksmith-runner-bench",
  "version": "1.0.0",
  "description": "Medium-size Node/TS codebase used purely to benchmark GitHub Actions runner options (GitHub-hosted vs Blacksmith) with no caching, so CI wall-clock time reflects raw runner performance.",
  "private": true,
  "scripts": {
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "build": "tsc -p tsconfig.json && webpack --config webpack.config.js",
    "test": "jest --verbose",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "dayjs": "^1.11.13",
    "axios": "^1.7.7",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "sharp": "^0.33.5",
    "puppeteer": "^23.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "ts-loader": "^9.5.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.16.11",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.10",
    "@types/uuid": "^9.0.8",
    "@types/jest": "^29.5.13"
  }
}
